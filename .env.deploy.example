# Kopieren nach ".env.deploy" (wird nicht versioniert, nur lokal bei dir!)
# Zugangsdaten aus deinem Hosting-Panel für www.red-it.org.

FTP_HOST=ftp.red-it.org
FTP_USER=dein-ftp-benutzer
FTP_PASSWORD=dein-ftp-passwort
FTP_PORT=21
# true = FTPS (empfohlen, die meisten Hoster unterstützen das). Falls dein
# Hoster nur reines FTP ohne Verschlüsselung anbietet: auf false stellen.
FTP_SECURE=true

# Nur ändern, wenn dein Zielordner wirklich anders heißt.
# Das Deploy-Skript fasst NIE etwas außerhalb dieses Ordners an.
REMOTE_BASE_DIR=/apps/neighborhood
